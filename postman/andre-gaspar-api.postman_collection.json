{
  "info": {
    "name": "Gestão de Perícias — Etapa 4",
    "description": "Demonstração dos avisos pelo RabbitMQ e da importação de atividades pelo Spring Batch. Para testar o consumidor parado, siga o procedimento do README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "principal",
      "value": "http://localhost:8080"
    },
    {
      "key": "peritos",
      "value": "http://localhost:8081"
    },
    {
      "key": "nomeacaoId",
      "value": "1"
    },
    {
      "key": "peritoId",
      "value": "1"
    },
    {
      "key": "avisoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Publicar aviso de nomeação",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "const aviso = pm.response.json();",
              "pm.test(\"Aviso identificado\", () => pm.expect(aviso.avisoId).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"avisoId\", aviso.avisoId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{principal}}/api/nomeacoes/{{nomeacaoId}}/avisos"
      }
    },
    {
      "name": "Consultar avisos do perito",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta é lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{peritos}}/api/peritos/{{peritoId}}/avisos"
      }
    },
    {
      "name": "Importar atividades CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const resultado = pm.response.json();",
              "pm.test(\"Job concluído\", () => pm.expect(resultado.status).to.eql(\"COMPLETED\"));",
              "pm.test(\"Seis linhas lidas\", () => pm.expect(resultado.lidos).to.eql(6));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{principal}}/api/importacoes/atividades"
      }
    },
    {
      "name": "Listar atividades após importação",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta é lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{principal}}/api/atividades"
      }
    }
  ]
}
